[
    {
        "id": "ipv6-ssh",
        "description": "Allow SSH access from specific IPv6 range to all VMs",
        "action": "ALLOW",
        "direction": "INGRESS",
        "log_config": "EXCLUDE_ALL_METADATA",
        "priority": 1000,
        "sources": [
            "2001:db8::/32"
        ],
        "targets": [],
        "rules": [
            {
                "protocol": "TCP",
                "ports": ["22"]
            }
        ]
    },
    {
        "id": "ipv6-https",
        "description": "Allow HTTPS from any IPv6 address to web servers",
        "action": "ALLOW",
        "direction": "INGRESS",
        "log_config": "DISABLED",
        "priority": 1000,
        "sources": [
            "::/0"
        ],
        "targets": [
            "web-server"
        ],
        "rules": [
            {
                "protocol": "TCP",
                "ports": ["443"]
            }
        ]
    }
]
